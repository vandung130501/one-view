
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}
model Item {
  id        Int                       @id @default(autoincrement())
  embedding Unsupported("vector(1536)")?
}
